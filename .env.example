# research-engine — example configuration
#
# Copy to .env, fill in what you need, then either:
#   export RESEARCH_ENGINE_ENV_FILE=/path/to/.env
# or export the variables directly.
#
# EVERYTHING HERE IS OPTIONAL. With nothing set, data goes to ~/.research_engine
# and CLI tools are found on your PATH. Set only what you actually use.
#
# Precedence: if a RESEARCH_ENGINE_*_BIN variable is set it WINS. Only when it is
# unset does the code fall back to shutil.which() on your PATH.
#
# NEVER commit your filled-in .env — .gitignore already blocks it.


# ── Core ─────────────────────────────────────────────────────────────────────

# Where telemetry, logs, the session store and the memory DB are written.
# Default: ~/.research_engine
RESEARCH_ENGINE_DATA_DIR=

# Your contact address, used in outbound User-Agent headers. Crossref and the
# Wayback Machine give better rate limits when you supply one. Unset means
# requests go out with no contact and are rate-limited harder.
RESEARCH_ENGINE_CONTACT_EMAIL=

# Override the whole User-Agent string. Takes priority over CONTACT_EMAIL.
RESEARCH_ENGINE_USER_AGENT=

# Optional .env file for the engine to load API keys from.
RESEARCH_ENGINE_ENV_FILE=


# ── CLI tools ────────────────────────────────────────────────────────────────
# Only needed if the tool is NOT on your PATH.
# A missing required binary raises an error naming the variable to set.

RESEARCH_ENGINE_CODEX_BIN=
RESEARCH_ENGINE_CLAUDE_BIN=
RESEARCH_ENGINE_CLAUDE_HOME=
RESEARCH_ENGINE_AGY_BIN=
RESEARCH_ENGINE_GROK_BIN=
RESEARCH_ENGINE_OLLAMA_BIN=
RESEARCH_ENGINE_PYTHON_BIN=

# The Crawl4AI rung shells out to a helper script that is NOT shipped in this
# repo. Without this variable that rung returns nothing.
RESEARCH_ENGINE_CRAWL4AI_SCRIPT=


# ── Key-pool files ───────────────────────────────────────────────────────────
# Unset = that lane is skipped.

# Without this the Mistral worker is inert, so `research` mode runs 2 of its
# 3 workers.
RESEARCH_ENGINE_MISTRAL_KEYS_FILE=

RESEARCH_ENGINE_LANE_ENV_FILE=
RESEARCH_ENGINE_NORDVPN_ENV_FILE=
RESEARCH_ENGINE_OPENCLAW_ENV_FILE=
RESEARCH_ENGINE_APIFY_PROXY_MODULE=


# ── Storage overrides ────────────────────────────────────────────────────────
# All default to somewhere under RESEARCH_ENGINE_DATA_DIR.

RESEARCH_ENGINE_MEMORY_DB=
RESEARCH_ENGINE_RESEARCH_SESSIONS_DIR=
RESEARCH_ENGINE_NO_BLUFF_TELEMETRY_PATH=


# ── Local lanes — OFF unless set ─────────────────────────────────────────────
# These search your own files. If the path does not exist the lane reports
# "not configured: missing <path>. Set <ENV_VAR>." rather than returning an
# empty result set that looks like "nothing found".

RESEARCH_ENGINE_OBSIDIAN_GLOB=
RESEARCH_ENGINE_CLAUDE_MEMORY_GLOB=


# ── Optional integrations — OFF unless set ───────────────────────────────────

RESEARCH_ENGINE_BUZZ_SCRIPT=
RESEARCH_ENGINE_SEMANTIC_PROXY_PATH=
RESEARCH_ENGINE_CONSEQUENCE_TRACKER_ENV_FILE=
RESEARCH_ENGINE_CT_API_KEYS_STATE_FILE=


# ── Gemini budget ────────────────────────────────────────────────────────────
# Gemini calls per day before the engine silently swaps to GPT-OSS 120B.
# Default 300. RESEARCH_ENGINE_UNATTENDED=1 forces the swap immediately.
RESEARCH_ENGINE_GEMINI_DAILY_BUDGET=
RESEARCH_ENGINE_UNATTENDED=


# ── Third-party API keys ─────────────────────────────────────────────────────
# Read from the environment by individual search lanes. A lane whose key is
# missing fails that lane with a "requires env var" error; it does not fail
# the run.

GITHUB_TOKEN=
GITLAB_TOKEN=
DATA_GOV_API_KEY=
FEC_API_KEY=
OPENSTATES_API_KEY=
FDA_API_KEY=
EXA_API_KEY=
JINA_API_KEY=
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=


# ── Read-service tuning ──────────────────────────────────────────────────────
# Sensible defaults are built in; override only if you need to.

WEBREAD_SERVICE_HOST=
WEBREAD_SERVICE_PORT=
WEBREAD_CACHE_DIR=
WEBREAD_L3_TIMEOUT_S=
WEBREAD_L3_MIN_FREE_MB=
WEBREAD_L3_MAX_SWAP_MB=
WEBREAD_L3_KILL=


# ── Behaviour switches ───────────────────────────────────────────────────────

# 1 = skip LLM synthesis in grounding (heuristic answers only).
GROUNDING_DISABLE_LLM_SYNTHESIS=

# 1 = disable grounding telemetry writes.
GROUNDING_DISABLE_TELEMETRY=

# 1 = run the live-network scrapling tests (skipped by default).
RUN_LIVE_SCRAPLING=
